#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200 // 10

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define MOUSE 4
#define SCROLL 5

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 2>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp G &kp I &kp F>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            bindings = <
&kp MINUS       &kp N1  &kp N2                 &kp N3              &kp N4        &kp N5         &kp N6     &kp N7     &kp N8     &kp N9   &kp N0                   &kp EQUAL
&kp GRAVE       &kp Q   &kp W                  &kp E               &kp R         &kp T          &kp Y      &kp U      &kp I      &kp O    &kp P                    &kp BSLH
&kp ESC         &mt LGUI A  &mt LALT S         &mt LSHFT D         &mt LCTRL F   &kp G          &kp H      &kp J      &kp K      &kp L    &kp SEMI                 &kp SQT
&kp UNDERSCORE  &kp Z   &kp X                  &kp C               &kp V         &kp B          &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH                 &kp COLON
&kp LSHFT       &mo NAV &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp LALT  &kp BACKSPACE  &kp SPACE  &mt LGUI TAB  &kp LBKT  &kp RBKT  &lt SYM DELETE  &mt LCTRL ENTER
                                                                                  &kp K_MUTE
            >;

            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>;
        };

        nav_layer {
            bindings = <
&kp F1     &kp F2    &kp F3       &kp F4     &kp F5       &kp F6                 &kp F7                 &kp F8     &kp F9     &kp F10    &kp F11           &kp F12
&kp HOME   &trans    &trans        &kp UP     &kp EQUAL    &kp LEFT_BRACE         &kp RIGHT_BRACE        &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS       &kp END
&kp PG_UP  &trans    &kp LEFT      &kp DOWN   &kp RIGHT    &kp LEFT_BRACKET       &kp RIGHT_BRACKET      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS      &kp PG_DN
&trans     &kp LGUI  &kp LALT      &kp LSHFT  &kp LCTRL    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY   &kp GRAVE
&trans     &trans    &trans        &trans     &trans       &trans                 &kp KP_N0               &kp DEL    &trans     &trans     &mo ADJ           &trans
                                                                                  &trans
            >;

            label = "NAV";
            sensor-bindings = <&scroll_encoder>;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &trans         &trans        &trans        &trans       &trans         &trans          &trans          &trans          &trans          &trans             &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH     &kp DOLLAR   &kp PERCENT    &kp CARET       &kp AMPERSAND  &kp BSLH        &kp SQT        &kp DOUBLE_QUOTES  &trans
&trans  &kp GRAVE      &kp TILDE     &kp PIPE      &kp UNDERSCORE  &kp C_MUTE  &kp LC(LBKT)    &kp LC(LPAR)   &kp LC(RPAR)   &kp LC(RBKT)   &trans             &trans
&trans  &kp LGUI       &kp LALT      &kp LSHFT     &kp LCTRL    &kp C_VOL_UP   &kp C_VOL_DN    &kp LG(KP_MINUS)  &kp LG(EQUAL)  &trans       &trans             &trans
&trans  &mo ADJ        &trans        &trans        &trans       &gif           &trans          &trans          &trans          &trans          &trans             &trans
                                                                       &trans
            >;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD   &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans  &trans  &trans
&trans  &sys_reset   &bt BT_CLR  &out OUT_TOG  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &bootloader  &bt BT_NXT  &trans        &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &trans       &bt BT_PRV  &trans        &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans     &trans
&mo SCROLL  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans
            >;
        };

    };
};
